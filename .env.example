# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3001"

# Google OAuth Web Client ID (public identifier; no client secret needed).
# Add http://localhost and http://localhost:3001 as Authorized JavaScript origins.
# Place your actual configuration in .env.local, then restart npm run dev.
GOOGLE_CLIENT_ID=""

# LiveKit meeting service. Backend only: never use a VITE_ prefix for these.
# Leave empty to use `npm run meeting:server` on this computer in development.
# Production requires a real wss:// server and its matching private credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Production public WSS endpoint of this Talk backend's signaling gateway.
# Route signaling directly to the approved WSS backend. Leave blank for local routing.
MEETING_SIGNAL_URL=

# Public Firebase web-app configuration. All VITE_ variables are visible to browsers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=talk-fc3dc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talk-fc3dc
VITE_FIREBASE_STORAGE_BUCKET=talk-fc3dc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Opt-in fictional-number testing ONLY in Vite development on loopback hosts.
# Production builds/non-loopback hosts always use normal reCAPTCHA verification.
VITE_FIREBASE_PHONE_TESTING=false
# Local production builds additionally set this to false in .env.production.
# CI/deployment build environments must keep it false. See deployment/FIREBASE_HOSTING.md.
# Backend-only expected Firebase project. Signature checks need the project ID,
# not a private key. Never put Admin service-account keys in VITE_ variables.
FIREBASE_PROJECT_ID=talk-fc3dc
# Optional private inputs for tests/firebase-phone-live-browser.mjs only.
# Configure a fictional number/code in Firebase Authentication > Phone numbers
# for testing first. No real SMS is sent. Never add VITE_ prefixes or commit values.
FIREBASE_TEST_PHONE_NUMBER=
FIREBASE_TEST_OTP=
# Optional when the fictional number is outside +91 or +1:
FIREBASE_TEST_COUNTRY_CODE=
# Optional private input for read-only cloud inspection, never for the browser.
# This compares your intended personal E.164 number with Firebase's test list;
# it never sends SMS. Do not add VITE_ or copy into production.
REAL_SMS_PHONE_NUMBER=

# Backend-only verification email delivery. Gmail requires an App Password
# generated with 2-Step Verification enabled, not your normal Gmail password.
# Put real values in .env or .env.local. Never prefix these with VITE_.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SQLite location (relative to the project root). Migrations run on startup.
AUTH_DATABASE_PATH=data/talk.sqlite

# Local development retains SQLite/native cookies. Production uses the separate
# backend-only template in deployment/backend.env.example and Secret Manager.
# Never copy private backend production settings into frontend build variables.
AUTH_DB_DRIVER=sqlite
AUTH_COOKIE_MODE=native

# Backend-only meeting recording. No cloud services are provisioned automatically.
# Development uses installed Chrome and private data/recordings by default.
# Set disabled to turn capture off. Production requires an explicit local-browser
# worker, private durable storage, Chromium sandbox support and persistent CPU.
RECORDING_PROVIDER=
RECORDING_STORAGE=local
RECORDING_LOCAL_PATH=data/recordings
RECORDING_DURABLE_VOLUME=false
RECORDING_GCS_BUCKET=
CHROMIUM_PATH=
FFMPEG_PATH=
# Run npm run recording:setup for the local Windows multilingual Whisper model.
# Production must supply matching platform binaries and a private model mount.
WHISPER_EXECUTABLE=
WHISPER_MODEL_PATH=
# Optional English-specific override. Local default uses the installed multilingual
# small-q5_1 model when present; otherwise it keeps the base model. No download.
WHISPER_ENGLISH_MODEL_PATH=
# Optional separate Hindi accuracy model; English and language detection use the model above.
# Local recording:setup installs ggml-medium-q5_0.bin automatically. CPU Hindi processing is slow.
WHISPER_HINDI_MODEL_PATH=
WHISPER_THREADS=2

# Phase 10I cloud whiteboard AI: architecture only; real HTTPS transport release-locked.
WHITEBOARD_CLOUD_AI_ENABLED=false
WHITEBOARD_CLOUD_AI_OPERATOR_APPROVED=false
WHITEBOARD_CLOUD_AI_PROVIDER=none
WHITEBOARD_CLOUD_AI_MODEL=
WHITEBOARD_CLOUD_AI_BASE_URL=
WHITEBOARD_CLOUD_AI_ALLOWED_BASE_URLS=
WHITEBOARD_CLOUD_AI_API_KEY=
WHITEBOARD_CLOUD_AI_RESPONSE_FORMAT=json_schema
WHITEBOARD_CLOUD_AI_TOKEN_FIELD=max_tokens
WHITEBOARD_CLOUD_AI_MAX_INPUT_TOKENS=8192
WHITEBOARD_CLOUD_AI_MAX_OUTPUT_TOKENS=2048
WHITEBOARD_CLOUD_AI_REQUEST_TIMEOUT_MS=45000
WHITEBOARD_CLOUD_AI_MAX_REQUESTS_PER_USER=5
WHITEBOARD_CLOUD_AI_MAX_REQUESTS_PER_MEETING=10
WHITEBOARD_CLOUD_AI_MAX_CONCURRENT=1
# Optional operator-supplied prices per million tokens, ISO currency and monthly estimate limit.
WHITEBOARD_CLOUD_AI_INPUT_PRICE_PER_MILLION=
WHITEBOARD_CLOUD_AI_OUTPUT_PRICE_PER_MILLION=
WHITEBOARD_CLOUD_AI_PRICE_CURRENCY=
WHITEBOARD_CLOUD_AI_ESTIMATED_SPEND_LIMIT=

# Scheduling outbound email is a separate explicit opt-in. Disabled by default.
# Uses existing SMTP settings only when true; never changes authentication email.
SCHEDULING_EMAIL_ENABLED=false
# Configure these only before a separately authorized real delivery test.
# Stable HTTPS origin; loopback HTTP is accepted for local mock testing only.
SCHEDULING_PUBLIC_URL=http://localhost:3001
# Dedicated random 32-byte base64url server secret. Never use a VITE_ variable.
SCHEDULING_EMAIL_LINK_SECRET=

# Separate Google Calendar integration (all live operations disabled by default).
GOOGLE_CALENDAR_PUBLIC_URL=http://localhost:3001
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Dedicated Node crypto.randomBytes(32).toString('base64url'); backend only.
GOOGLE_CALENDAR_TOKEN_KEY=
GOOGLE_CALENDAR_OAUTH_ENABLED=false
GOOGLE_CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_READ_ENABLED=false
GOOGLE_CALENDAR_INVITATIONS_ENABLED=false
