{
  "name": "talk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @talk/frontend",
    "tunnel-test:check": "node scripts/tunnel-test.mjs --check",
    "tunnel-test:start": "node scripts/tunnel-test.mjs --start",
    "test:tunnel-test": "node --test tests/tunnel-test.test.mjs",
    "build": "npm run build --workspace @talk/frontend",
    "preview": "npm run preview --workspace @talk/frontend",
    "start": "npm run start --workspace @talk/backend",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:browser": "node tests/browser-smoke.mjs",
    "meeting:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-livekit-local.ps1",
    "meeting:server": "node scripts/start-meeting-server.mjs",
    "test:meetings": "node --test tests/meetings-server.test.mjs tests/meeting-management.test.mjs",
    "test:meetings:moderation": "node tests/meeting-moderation-browser.mjs",
    "test:meetings:waiting-room": "node tests/waiting-room-browser.mjs",
    "test:assistant": "node --test tests/transcript-revisions.test.mjs tests/assistant-grounding.test.mjs tests/assistant-provider.test.mjs tests/assistant-import.test.mjs tests/meeting-assistant.test.mjs",
    "test:assistant:postgres": "node scripts/test-production-postgres.mjs --assistant-only",
    "test:meetings:restricted-share": "node tests/meeting-restricted-share-browser.mjs",
    "test:meetings:browser": "node tests/meetings-browser.mjs",
    "test:meetings:two-rooms": "node tests/meetings-two-rooms-browser.mjs",
    "test:meetings:ui": "node --import tsx --test tests/meeting-experience.test.ts",
    "test:avatars": "node --test tests/avatars-server.test.mjs",
    "test:reactions:ui": "node --import tsx --test tests/reactions-avatars.test.ts",
    "test:reactions:browser": "node tests/reactions-avatars-browser.mjs",
    "test:backgrounds": "node --import tsx --test tests/backgrounds.test.ts",
    "test:backgrounds:browser": "node tests/backgrounds-browser.mjs",
    "test:video-effects": "node --import tsx --test tests/video-effects.test.ts",
    "test:video-effects:browser": "node tests/video-effects-browser.mjs",
    "test:video-effects:lifecycle": "node tests/video-effects-lifecycle-browser.mjs",
    "test:meetings:experience": "node tests/meeting-experience-browser.mjs",
    "test:visual": "node tests/visual-check.mjs",
    "test:auth": "node --test tests/google-auth-server.test.mjs tests/google-confirmation-server.test.mjs tests/email-auth-server.test.mjs tests/verification-mailer.test.mjs tests/firebase-phone-server.test.mjs",
    "db:migrate": "npm run db:migrate --workspace @talk/backend",
    "smtp:check": "npm run smtp:check --workspace @talk/backend",
    "smtp:test-send": "npm run smtp:test-send --workspace @talk/backend",
    "test:auth:browser": "node tests/email-auth-browser.mjs",
    "test:auth:google-browser": "node tests/google-confirmation-browser.mjs",
    "test:auth:passwords": "node --import tsx --test tests/browser-passwords.test.ts",
    "test:auth:otp-browser": "node tests/otp-signup-browser.mjs",
    "test:auth:phone-browser": "node tests/firebase-phone-browser.mjs",
    "test:auth:phone-live": "node tests/firebase-phone-live-browser.mjs",
    "hosting:prepare": "node scripts/prepare-hosting.mjs",
    "hosting:check": "node scripts/hosting-preflight.mjs",
    "hosting:inspect": "node scripts/inspect-firebase-hosting.mjs",
    "cloud:inspect": "node scripts/inspect-cloud-readiness.mjs",
    "team:inspect": "node scripts/inspect-team-infrastructure.mjs",
    "test:team:config": "node --test tests/team-deployment-config.test.mjs tests/team-infrastructure.test.mjs tests/cloud-readiness.test.mjs",
    "cloud:login": "node scripts/cloud-login.mjs",
    "test:cloud-readiness": "node --test tests/cloud-readiness.test.mjs",
    "sms-test:build": "node scripts/prepare-sms-test.mjs",
    "sms-test:check": "node scripts/check-sms-test.mjs",
    "sms-test:hosting-status": "node scripts/sms-test-hosting-status.mjs",
    "test:sms-test": "node tests/standalone-sms-browser.mjs",
    "test:hosting": "node --test tests/firebase-hosting.test.mjs",
    "test:auth:production": "node scripts/test-production-postgres.mjs",
    "test:auth:production-unit": "node --test tests/production-auth.test.mjs",
    "test:auth:hosting-browser": "node tests/hosting-auth-browser.mjs",
    "backend:prepare-env": "node scripts/prepare-production-env.mjs",
    "backend:check": "node scripts/backend-preflight.mjs",
    "db:migrate:production": "npm run db:migrate:production --workspace @talk/backend",
    "db:import:production": "npm run db:import:production --workspace @talk/backend",
    "recording:setup": "node scripts/setup-recording-transcription.mjs",
    "recording:prepare": "node scripts/prepare-recording-client.mjs",
    "test:recordings": "node --test tests/meeting-recordings.test.mjs tests/recording-bundle.test.mjs tests/recording-processing.test.mjs tests/recording-exports-lifecycle.test.mjs tests/recording-storage-cloud.test.mjs tests/recording-model-selection.test.mjs",
    "test:recordings:save": "node --import ./tests/helpers/cloud-egress-guard.mjs tests/recording-save-browser.mjs",
    "test:recordings:screen": "node --import ./tests/helpers/cloud-egress-guard.mjs tests/recording-screen-share-browser.mjs",
    "test:recordings:browser": "node tests/recordings-browser.mjs",
    "test:transcription:real": "node scripts/test-local-transcription.mjs",
    "build:whiteboard": "vite build --config frontend/vite.config.ts --outDir ../artifacts/qa/phase10-build --emptyOutDir",
    "whiteboard:local": "node scripts/start-whiteboard-local.mjs",
    "test:whiteboard": "node --test --test-concurrency=1 tests/whiteboards-server.test.mjs",
    "test:whiteboard:postgres": "node scripts/test-production-postgres.mjs --whiteboard-only",
    "test:whiteboard:browser": "node tests/whiteboards-browser.mjs",
    "test:whiteboard:tools": "node tests/whiteboard-tools-browser.mjs",
    "test:auth:reset": "node --test --test-concurrency=1 tests/password-reset.test.mjs tests/verification-mailer.test.mjs",
    "test:auth:reset:browser": "node tests/password-reset-browser.mjs",
    "test:auth:reset:postgres": "node scripts/test-production-postgres.mjs --password-reset-only",
    "test:whiteboard:ai": "node --test --test-concurrency=1 tests/whiteboard-intelligence-model.test.mjs tests/whiteboard-intelligence-provider.test.mjs tests/whiteboard-intelligence-server.test.mjs",
    "test:whiteboard:ai:postgres": "node scripts/test-production-postgres.mjs --whiteboard-ai-only",
    "test:whiteboard:ai:browser": "node tests/whiteboard-intelligence-browser.mjs",
    "test:whiteboard:cloud": "node --import ./tests/helpers/cloud-egress-guard.mjs --test --test-concurrency=1 tests/whiteboard-cloud-first-test.test.mjs tests/whiteboard-cloud-provider.test.mjs tests/whiteboard-cloud-server.test.mjs",
    "test:whiteboard:cloud:postgres": "node scripts/test-production-postgres.mjs --whiteboard-cloud-only",
    "test:whiteboard:cloud:browser": "node --import ./tests/helpers/cloud-egress-guard.mjs tests/whiteboard-cloud-browser.mjs",
    "test:whiteboard:cloud:regression-browser": "node --import ./tests/helpers/cloud-egress-guard.mjs tests/phase10i-whiteboard-regression-browser.mjs",
    "test:scheduling": "node --import ./tests/helpers/cloud-egress-guard.mjs --test --test-concurrency=1 tests/scheduling.test.mjs tests/scheduling-server.test.mjs tests/scheduling-email-templates.test.mjs tests/scheduling-email-transport.test.mjs tests/scheduling-email-jobs.test.mjs tests/scheduling-email-smoke.test.mjs",
    "test:scheduling:browser": "node --import ./tests/helpers/cloud-egress-guard.mjs tests/scheduling-browser.mjs",
    "test:scheduling:postgres": "node scripts/test-production-postgres.mjs --scheduling-only",
    "test:scheduling:email": "node --import ./tests/helpers/cloud-egress-guard.mjs --test --test-concurrency=1 tests/scheduling-email-templates.test.mjs tests/scheduling-email-transport.test.mjs tests/scheduling-email-jobs.test.mjs tests/scheduling-email-smoke.test.mjs",
    "test:scheduling:client": "node --import ./tests/helpers/cloud-egress-guard.mjs --import tsx --test tests/scheduling-client.test.ts",
    "scheduling:email:prepare": "node --import ./tests/helpers/cloud-egress-guard.mjs scripts/prepare-scheduling-email-test.mjs",
    "test:calendar": "node --import ./tests/helpers/cloud-egress-guard.mjs --test --test-concurrency=1 tests/google-calendar.test.mjs tests/google-calendar-server.test.mjs",
    "test:calendar:browser": "node --import ./tests/helpers/cloud-egress-guard.mjs tests/google-calendar-browser.mjs",
    "test:calendar:postgres": "node scripts/test-production-postgres.mjs --calendar-only"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@firebase/app": "0.14.8",
    "@firebase/app-compat": "0.5.8",
    "@grpc/grpc-js": "1.14.6"
  }
}
