# Backend only. Never upload this file with frontend assets.
NODE_ENV=production
APP_URL=https://talk-fc3dc.web.app
HOST=0.0.0.0
PORT=8080
AUTH_DB_DRIVER=postgres
# Backend-only LiveKit credentials. Required for the team meeting deployment.
# Use the approved project's WSS origin, without paths or query parameters.
# Example: wss://PROJECT.livekit.cloud; local SFU addresses are forbidden in production.
# Verify the actual hosted Cloud signaling handshake and reconnection before release.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Public WSS endpoint directly on the approved Cloud Run backend, not Firebase Hosting.
# Example: wss://SERVICE-HASH-REGION.run.app/api/auth/meeting-signal
# Confirm WebSocket upgrades, reconnection after 3600s, and query-token log exclusion.
# Missing or invalid meeting configuration fails closed; authentication remains available.
MEETING_SIGNAL_URL=
AUTH_COOKIE_MODE=hosting
# A persistent 32-byte random base64url key, stored in Secret Manager.
AUTH_COOKIE_SECRET=
# Optional previous key for a controlled rotation/grace period.
AUTH_COOKIE_SECRET_PREVIOUS=
# Confirm the actual ingress chain before launch. Never use trust-all.
TRUSTED_PROXY_CIDRS=127.0.0.1/8,::1/128,169.254.0.0/16
PGHOST=/cloudsql/talk-fc3dc:asia-south1:talk-auth-db
PGPORT=5432
PGDATABASE=talk_auth
PGUSER=talk_auth
PGPASSWORD=
PGPOOL_MAX=5
# The five-person/two-room review template caps Cloud Run at one instance.
# Reassess total connection limits before increasing either cap.
# Cloud SQL Unix socket uses the managed authenticated/encrypted proxy.
# Remote TCP databases instead require verify-full and an appropriate CA.
PGSSLMODE=verify-full
PGSSL_CA=
FIREBASE_PROJECT_ID=talk-fc3dc
GOOGLE_CLIENT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional recording/STT workers. Disabled until infrastructure is approved.
RECORDING_PROVIDER=disabled
RECORDING_STORAGE=gcs
RECORDING_GCS_BUCKET=
RECORDING_LOCAL_PATH=/tmp/talk-recordings
RECORDING_DURABLE_VOLUME=false
CHROMIUM_PATH=/usr/bin/chromium
FFMPEG_PATH=/usr/bin/ffmpeg
WHISPER_EXECUTABLE=
WHISPER_MODEL_PATH=

# Phase 10I cloud whiteboard AI: architecture only; real HTTPS transport release-locked.
WHITEBOARD_CLOUD_AI_ENABLED=false
WHITEBOARD_CLOUD_AI_OPERATOR_APPROVED=false
WHITEBOARD_CLOUD_AI_PROVIDER=none
WHITEBOARD_CLOUD_AI_MODEL=
WHITEBOARD_CLOUD_AI_BASE_URL=
WHITEBOARD_CLOUD_AI_ALLOWED_BASE_URLS=
WHITEBOARD_CLOUD_AI_API_KEY=
WHITEBOARD_CLOUD_AI_RESPONSE_FORMAT=json_schema
WHITEBOARD_CLOUD_AI_TOKEN_FIELD=max_tokens
WHITEBOARD_CLOUD_AI_MAX_INPUT_TOKENS=8192
WHITEBOARD_CLOUD_AI_MAX_OUTPUT_TOKENS=2048
WHITEBOARD_CLOUD_AI_REQUEST_TIMEOUT_MS=45000
WHITEBOARD_CLOUD_AI_MAX_REQUESTS_PER_USER=5
WHITEBOARD_CLOUD_AI_MAX_REQUESTS_PER_MEETING=10
WHITEBOARD_CLOUD_AI_MAX_CONCURRENT=1
# Optional operator-supplied prices per million tokens, ISO currency and monthly estimate limit.
WHITEBOARD_CLOUD_AI_INPUT_PRICE_PER_MILLION=
WHITEBOARD_CLOUD_AI_OUTPUT_PRICE_PER_MILLION=
WHITEBOARD_CLOUD_AI_PRICE_CURRENCY=
WHITEBOARD_CLOUD_AI_ESTIMATED_SPEND_LIMIT=
